# ============================================================
# RPS Stationery — Environment Variables Template
# Project: rps-statationary-jaipur
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to Git!
# ============================================================

# ─── Firebase Admin SDK Credentials (Server-Side — SECRET) ──────────────────
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rps-statationary-jaipur
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@rps-statationary-jaipur.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Firebase Realtime Database ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://rps-statationary-jaipur-default-rtdb.asia-southeast1.firebasedatabase.app

# ─── Firebase Storage ────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rps-statationary-jaipur.firebasestorage.app

# ─── Firebase Client SDK Credentials (Public) ───────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rps-statationary-jaipur.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1090273726787
NEXT_PUBLIC_FIREBASE_APP_ID=1:1090273726787:web:27c6ed23f27641cc701ff6
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EPKFWR4DHS

# ─── Zoho Mail (Server-Side — SECRET) ───────────────────────────────────────
ZOHO_MAIL_USER=your-email@yourdomain.in
ZOHO_MAIL_PASSWORD=your-app-specific-password
ZOHO_MAIL_FROM=noreply@yourdomain.in
MARKETING_EMAIL_FROM_NAME="RPS Stationery"
MARKETING_EMAIL_REPLY_TO=support@yourdomain.in

# ─── Instructions ────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local
# 2. For FIREBASE_PRIVATE_KEY: open the service account JSON and paste the
#    private_key value. Make sure newlines are escaped as \n inside quotes.
# 3. Get your API key from Firebase Console > Project Settings > General > Your Apps
# 4. For Zoho: use an app-specific password, NOT your main account password.
#    India SMTP: smtp.zoho.in:465